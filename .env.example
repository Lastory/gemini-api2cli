#### 【服务基本配置】

# 指定本地监听端口（默认 41242）
CODER_AGENT_PORT=41242

# 指定控制台和API的令牌（默认 root）
GEMINI_PROMPT_API_TOKEN=root

#### 【CLI行为配置】

# Google Cloud 项目 ID
# GOOGLE_CLOUD_PROJECT=your_project_id

# 提示词注入级别（默认 full）
# - full: 注入完整提示词，适用于工程对话。
# - reduced: 屏蔽专用于工程对话的部分（如目录树、代码规范），保留适用范围更广的工具。
# - minimal: 最小化注入，发送用户输入的提示词。
# GEMINI_PROMPT_INJECTION_LEVEL=full

#### 【控制台预配置】

# 凭据轮询（默认 true）
# 错误自动重试（默认 true）
# 重试次数，范围 1-10（默认 3）

# GEMINI_PROMPT_API_ROTATION_ENABLED=true
# GEMINI_PROMPT_API_RETRY_ENABLED=true
# GEMINI_PROMPT_API_RETRY_COUNT=3

# 最大进程数，0 = 不限制（默认 2）
# 故障转移进程，预热的备用进程，故障转移时即时切换（默认 1）
# 进程空闲超时（秒），0 = 不超时（默认 0）
# 保活间隔（秒），0 = 关闭（默认 540）

# GEMINI_PROMPT_API_MAX_WORKERS=2
# GEMINI_PROMPT_API_FAILOVER_WORKERS=1
# GEMINI_PROMPT_API_ACP_IDLE_TIMEOUT_SEC=0
# GEMINI_PROMPT_API_ACP_KEEPALIVE_INTERVAL_SEC=540