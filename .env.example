#### 【服务基本配置】

# 指定本地监听端口（默认 41242）
CODER_AGENT_PORT=41242

# 指定控制台和API的令牌（默认 root）
GEMINI_PROMPT_API_TOKEN=root

#### 【CLI行为配置】

# Google Cloud 项目 ID
# GOOGLE_CLOUD_PROJECT=your_project_id

# 提示词注入级别（默认 full）
# - full: 注入完整提示词，适用于工程对话。
# - reduced: 屏蔽专用于工程对话的部分（如目录树、代码规范），保留适用范围更广的工具。
# - minimal: 最小化注入，发送用户输入的提示词。
# GEMINI_PROMPT_INJECTION_LEVEL=full

#### 【控制台预配置 (A2A-Server HTTP 管理控制台设置)】
# 以下变量用于预配置管理控制台（/manage 或 /v1/settings）中的各项运行时设置。
# 启动后可在控制台界面实时动态修改并生效。
# （兼容性说明：旧版 GEMINI_PROMPT_API_* 前缀变量仍会自动降级兼容）

# 凭据轮询（默认 true）
# A2A_CONSOLE_ROTATION_ENABLED=true

# 错误自动重试（默认 true）
# A2A_CONSOLE_RETRY_ENABLED=true

# 重试次数，范围 1-10（默认 3）
# A2A_CONSOLE_RETRY_COUNT=3

# 请求超时时间（秒），0 = 使用系统默认 600 秒（默认 0）
# A2A_CONSOLE_TIMEOUT_SEC=0

# 最大工作进程数，0 = 不限制（默认 2）
# A2A_CONSOLE_MAX_WORKERS=2

# 故障转移备用进程数，预热的备用进程，故障转移时即时切换（默认 1）
# A2A_CONSOLE_FAILOVER_WORKERS=1

# 进程空闲超时（秒），0 = 从不超时（默认 0）
# A2A_CONSOLE_IDLE_TIMEOUT_SEC=0

# 会话保活间隔（秒），0 = 关闭保活（默认 540）
# A2A_CONSOLE_KEEPALIVE_SEC=540

# 默认选用模型（留空使用系统默认 auto-gemini-2.5）
# A2A_CONSOLE_DEFAULT_MODEL=auto-gemini-2.5

# MCP 工具调用支持（默认 false）
# A2A_CONSOLE_MCP_ENABLED=false

# 扩展插件支持（默认 false）
# A2A_CONSOLE_EXTENSIONS_ENABLED=false

# 技能支持（默认 false）
# A2A_CONSOLE_SKILLS_ENABLED=false

# 上游出网代理（留空使用系统环境代理）
# A2A_CONSOLE_PROXY_URL=http://127.0.0.1:7890